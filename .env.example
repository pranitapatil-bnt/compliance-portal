NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=
COMPLIANCE_API_BASE=
SESSION_SECRET=replace-with-a-long-random-string

# People login (OIDC authorization code). Create client compliance-portal-web in Keycloak.
KEYCLOAK_ISSUER=http://localhost:8180/auth/realms/ethos-internal
KEYCLOAK_PORTAL_CLIENT_ID=compliance-portal-web
KEYCLOAK_PORTAL_CLIENT_SECRET=replace-with-portal-client-secret

# API / service-to-service token (auth_token_service). Not used for human login.
KEYCLOAK_TOKEN_URL=http://localhost:8180/auth/realms/ethos-internal/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=auth_token_service
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_USERNAME=ethos_api_user
KEYCLOAK_PASSWORD=
